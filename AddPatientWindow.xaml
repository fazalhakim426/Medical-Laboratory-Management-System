<Window x:Class="LabReportApp.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Patient" Height="600" Width="640"
        MinHeight="500" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ColorBackground}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="Add Patient" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Register a patient once, then reuse them for future bills."
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                    <TextBlock Text="PATIENT NAME *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtName" Height="42"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                    <TextBlock Text="PHONE NUMBER *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPhone" Height="42"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Text="CNIC *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCnic" Height="42" MaxLength="15"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                    <TextBlock Text="AGE *" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtAge" Height="42" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbAgeUnit" Grid.Column="1" Height="42" SelectedIndex="2">
                            <ComboBoxItem Content="Days"/>
                            <ComboBoxItem Content="Months"/>
                            <ComboBoxItem Content="Years"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                    <TextBlock Text="GENDER *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbGender" Height="42" SelectionChanged="cmbGender_SelectionChanged">
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,12">
                    <TextBlock Text="DATE OF BIRTH (optional)" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="dpDob" Height="42" SelectedDateChanged="dpDob_SelectedDateChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,12">
                    <TextBlock Text="PREGNANCY STATUS" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbPregnancy" Height="42" SelectedIndex="0" IsEnabled="False">
                        <ComboBoxItem Content="Not Applicable"/>
                        <ComboBoxItem Content="Pregnant"/>
                        <ComboBoxItem Content="Non-Pregnant"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,12">
                    <TextBlock Text="REFERRED BY (DOCTOR)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbReferredBy" Height="42" IsEditable="True"
                                  IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Manage" Style="{StaticResource SecondaryButton}"
                                Height="42" MinWidth="88" Margin="8,0,0,0" Padding="10,0"
                                ToolTip="Manage Doctors" Click="btnManageDoctors_Click"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,12">
                    <TextBlock Text="VISIT LAB NAME (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Bills and reports use the hospital name from Settings. This does not replace Lab ProX."
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtLabName" Height="42"/>
                </StackPanel>

                <TextBlock x:Name="txtError" Grid.Row="5" Grid.ColumnSpan="2"
                           Foreground="{DynamicResource ColorDanger}" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="btnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnSave" Content="Save Patient" Style="{StaticResource AccentButton}" Click="btnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
