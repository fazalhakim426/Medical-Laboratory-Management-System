<Window x:Class="LabReportApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Lab ProX" Height="760" Width="760"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBackground}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="MultilineBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource ColorInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Hospital identity for bills and reports. Lab ProX branding stays fixed."
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Border Style="{StaticResource CardBackground}"/>
                    <Border Style="{StaticResource CardContent}">
                        <StackPanel>
                            <TextBlock Text="Lab ProX" Style="{StaticResource SectionHeading}"/>
                            <TextBlock x:Name="txtBrandNotice" TextWrapping="Wrap" Margin="0,6,0,8"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}"/>
                            <Border Background="{DynamicResource ColorPrimaryLight}" CornerRadius="8" Padding="12,8">
                                <TextBlock x:Name="txtLockedFooter" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Border Style="{StaticResource CardBackground}"/>
                    <Border Style="{StaticResource CardContent}">
                        <StackPanel>
                            <TextBlock Text="Hospital / laboratory identity" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="This name, logo and contact block are printed on your bills, receipts and laboratory reports."
                                       TextWrapping="Wrap" Margin="0,6,0,12" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>

                            <TextBlock Text="HOSPITAL / LABORATORY NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtHospitalName" Height="42" Margin="0,0,0,10"/>

                            <TextBlock Text="TAGLINE" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtTagline" Height="42" Margin="0,0,0,10"/>

                            <TextBlock Text="LOGO" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="72" Height="72" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1"
                                        CornerRadius="8" Background="{DynamicResource ColorInputBg}" Margin="0,0,12,0">
                                    <Image x:Name="imgLogo" Stretch="Uniform" Margin="6"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtNoLogo" Text="No logo selected." TextWrapping="Wrap" MaxWidth="360"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}"/>
                                    <TextBlock x:Name="txtLogoFile" TextWrapping="Wrap" MaxWidth="420" Margin="0,4,0,8"
                                               FontSize="12" Foreground="{DynamicResource ColorTextSecondary}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Choose logo" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Click="btnBrowseLogo_Click"/>
                                        <Button Content="Remove logo" Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0" Padding="14,0" Click="btnClearLogo_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="PNG or JPEG. The Lab ProX mark on the PDF footer is separate and stays in place."
                                       TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>

                            <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtAddress" Style="{StaticResource MultilineBox}" Height="72" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CITY" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtCity" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtPhone" Height="42"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtEmail" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="WEBSITE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtWebsite" Height="42"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="REGISTRATION / LICENSE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtRegistration" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="WORKING HOURS" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtHours" Height="42"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="OTHER LABORATORY INFORMATION" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtExtra" Style="{StaticResource MultilineBox}" Height="72" Margin="0,0,0,14"/>

                            <Button Content="Save laboratory identity" Style="{StaticResource AccentButton}"
                                    Height="42" HorizontalAlignment="Left" Padding="16,0" Click="btnSaveBranding_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Border Style="{StaticResource CardBackground}"/>
                    <Border Style="{StaticResource CardContent}">
                        <StackPanel>
                            <TextBlock Text="Backup and Restore" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="A copy of the database is saved to the backup folder. Restore replaces the current database with a file you choose."
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}"
                                       TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <TextBlock Text="BACKUP FOLDER" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtBackupFolder" Height="42" IsReadOnly="True" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Backup Now" Style="{StaticResource SecondaryButton}"
                                        Height="42" Padding="16,0" Click="btnBackupNow_Click"/>
                                <Button Content="Restore from Backup..." Style="{StaticResource DangerButton}"
                                        Height="42" Padding="16,0" Margin="10,0,0,0" Click="btnRestoreBackup_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
