<Window x:Class="LabReportApp.ManageDoctorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Doctors" Height="640" Width="820"
        MinHeight="500" MinWidth="700" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Manage Doctors" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Register referring doctors for quick selection on patient bills"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <StackPanel>
                        <TextBlock Text="Add / Edit Doctor" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                <TextBlock Text="DOCTOR NAME *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtName" Height="42"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                                <TextBlock Text="SPECIALTY" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSpecialty" Height="42"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPhone" Height="42"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                                <TextBlock Text="CLINIC / HOSPITAL" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtClinic" Height="42"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="5,12,0,0">
                            <Button x:Name="btnSave" Content="Save / Update Doctor" Style="{StaticResource AccentButton}"
                                    Click="btnSave_Click"/>
                            <Button Content="Clear Form" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="btnClear_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Padding="10">
                    <DataGrid x:Name="dgDoctors" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                              SelectionChanged="dgDoctors_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Specialty" Binding="{Binding Specialty}" Width="1.4*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.1*"/>
                            <DataGridTextColumn Header="Clinic" Binding="{Binding Clinic}" Width="1.5*"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="0.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                <Button Content="Deactivate Selected" Style="{StaticResource DangerButton}"
                        Click="btnDeactivate_Click"/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" Click="btnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
