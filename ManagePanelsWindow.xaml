<Window x:Class="LabReportApp.ManagePanelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Panels" Height="740" Width="1100"
        MinHeight="560" MinWidth="900" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Manage Panels" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Build packages such as CBC, LFT and RFT. The package price is what the bill charges."
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardBackground}"/>
                    <Border Style="{StaticResource CardContent}">
                        <StackPanel>
                            <TextBlock Text="Panel" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="PANEL NAME" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtName" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtCategory" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PACKAGE PRICE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtPrice" Height="42"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="This price is charged for the whole panel. It does not have to match the sum of the tests inside it. Bills already saved keep the price they were issued with."
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnSave" Content="Save Panel" Style="{StaticResource AccentButton}"
                                        Height="40" Click="btnSave_Click"/>
                                <Button Content="New Panel" Style="{StaticResource SecondaryButton}"
                                        Height="40" Margin="10,0,0,0" Click="btnClear_Click"/>
                                <Button Content="Delete Panel" Style="{StaticResource DangerButton}"
                                        Height="40" Margin="10,0,0,0" Click="btnDelete_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Border Style="{StaticResource CardBackground}"/>
                    <Border Style="{StaticResource CardContent}">
                        <DataGrid x:Name="dgPanels" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" BorderThickness="0"
                                  SelectionChanged="dgPanels_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Panel" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.3*"/>
                                <DataGridTextColumn Header="Package" Binding="{Binding PriceText}" Width="0.8*"/>
                                <DataGridTextColumn Header="Tests" Binding="{Binding TestCount}" Width="0.6*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="txtMemberHeading" Text="Tests in this panel" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Add existing individual tests. Removing a test here changes the panel for future bills only."
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Available tests" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Height="40" Margin="0,0,0,8"
                                         ToolTip="Search by test name or category"
                                         TextChanged="txtSearch_TextChanged"/>
                                <ListBox x:Name="lstAvailable" SelectionMode="Extended"
                                         MouseDoubleClick="lstAvailable_MouseDoubleClick"
                                         DisplayMemberPath="SuggestionLabel"/>
                            </DockPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,28,10,0">
                                <Button Content="Add →" Height="36" MinWidth="88" Margin="0,0,0,8"
                                        Style="{StaticResource AccentButton}" Click="btnAddTests_Click"/>
                                <Button Content="← Remove" Height="36" MinWidth="88"
                                        Style="{StaticResource SecondaryButton}" Click="btnRemoveTests_Click"/>
                            </StackPanel>

                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Included in the panel" Style="{StaticResource FieldLabel}"/>
                                <ListBox x:Name="lstMembers" SelectionMode="Extended"
                                         MouseDoubleClick="lstMembers_MouseDoubleClick"
                                         DisplayMemberPath="SuggestionLabel"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
