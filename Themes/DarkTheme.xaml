<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme with bright text and clearly separated cards. -->
    <SolidColorBrush x:Key="ColorPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="ColorPrimaryDark" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ColorPrimaryLight" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#15803D"/>
    <SolidColorBrush x:Key="ColorAccentDark" Color="#166534"/>
    <SolidColorBrush x:Key="ColorDanger" Color="#DC2626"/>
    <SolidColorBrush x:Key="ColorDangerDark" Color="#B91C1C"/>
    <SolidColorBrush x:Key="ColorBackground" Color="#0E141C"/>
    <SolidColorBrush x:Key="ColorCard" Color="#1B2433"/>
    <SolidColorBrush x:Key="ColorBorder" Color="#5C708A"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#D5DEEA"/>
    <SolidColorBrush x:Key="ColorHeaderBg" Color="#243044"/>
    <SolidColorBrush x:Key="ColorHeaderSubtitle" Color="#F1F5F9"/>
    <LinearGradientBrush x:Key="ColorBannerBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E4E8C" Offset="0"/>
        <GradientStop Color="#163A68" Offset="0.5"/>
        <GradientStop Color="#102844" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ColorScrollThumb" Color="#64748B"/>

    <SolidColorBrush x:Key="ColorSecondaryBg" Color="#243044"/>
    <SolidColorBrush x:Key="ColorSecondaryHoverBg" Color="#314056"/>
    <SolidColorBrush x:Key="ColorButtonDisabledBg" Color="#3A4658"/>
    <SolidColorBrush x:Key="ColorAccentDisabledBg" Color="#1E4A38"/>
    <SolidColorBrush x:Key="ColorInputBg" Color="#152033"/>
    <SolidColorBrush x:Key="ColorInputDisabledBg" Color="#121A28"/>
    <SolidColorBrush x:Key="ColorRowAlternate" Color="#212C3E"/>
    <SolidColorBrush x:Key="ColorHeaderButton" Color="#0B2544"/>
    <SolidColorBrush x:Key="ColorHeaderButtonHover" Color="#123056"/>
    <SolidColorBrush x:Key="ColorWave" Color="#162033"/>

    <SolidColorBrush x:Key="ColorStatusLow" Color="#F87171"/>
    <SolidColorBrush x:Key="ColorStatusHigh" Color="#FB923C"/>
    <SolidColorBrush x:Key="ColorStatusNormal" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ColorStatusNotConfigured" Color="#FBBF24"/>

    <SolidColorBrush x:Key="ColorFocusBorder" Color="#60A5FA"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#FB923C"/>

</ResourceDictionary>
