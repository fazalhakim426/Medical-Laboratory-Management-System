<Window x:Class="LabReportApp.BillHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bill History" Height="720" Width="1080"
        MinHeight="560" MinWidth="900" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Bill History" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Browse billed visits by date range — pending, completed, and refunded"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}">
                    <StackPanel>
                        <TextBlock Text="Date Range" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <RadioButton x:Name="rbYesterday" Content="Yesterday" GroupName="BillDate"
                                         Margin="0,0,16,8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource ColorTextPrimary}" FontWeight="SemiBold"
                                         Checked="DatePreset_Checked"/>
                            <RadioButton x:Name="rbToday" Content="Today" GroupName="BillDate" IsChecked="True"
                                         Margin="0,0,16,8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource ColorTextPrimary}" FontWeight="SemiBold"
                                         Checked="DatePreset_Checked"/>
                            <RadioButton x:Name="rbWeek" Content="This Week" GroupName="BillDate"
                                         Margin="0,0,16,8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource ColorTextPrimary}" FontWeight="SemiBold"
                                         Checked="DatePreset_Checked"/>
                            <RadioButton x:Name="rbMonth" Content="This Month" GroupName="BillDate"
                                         Margin="0,0,16,8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource ColorTextPrimary}" FontWeight="SemiBold"
                                         Checked="DatePreset_Checked"/>
                            <RadioButton x:Name="rbCustom" Content="Custom Range" GroupName="BillDate"
                                         Margin="0,0,16,8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource ColorTextPrimary}" FontWeight="SemiBold"
                                         Checked="DatePreset_Checked"/>
                        </WrapPanel>

                        <StackPanel x:Name="pnlCustomDates" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock Text="From" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource ColorTextPrimary}" Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpFrom" Width="160" Height="42" Margin="0,0,16,0"
                                        SelectedDateChanged="CustomDate_Changed"/>
                            <TextBlock Text="To" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource ColorTextPrimary}" Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpTo" Width="160" Height="42" Margin="0,0,16,0"
                                        SelectedDateChanged="CustomDate_Changed"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Grid Width="260" Margin="0,0,12,0">
                                <TextBox x:Name="txtSearch" Height="42" TextChanged="txtSearch_TextChanged"/>
                                <TextBlock Text="Search bill, patient, doctor" IsHitTestVisible="False"
                                           Margin="14,0,8,0" VerticalAlignment="Center" FontSize="13.5"
                                           Foreground="{DynamicResource ColorTextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox x:Name="cmbDoctor" Width="220" Height="42" Margin="0,0,12,0"
                                      DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Height="42"
                                    Padding="16,0" Click="btnRefresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Padding="10">
                    <DataGrid x:Name="dgBills" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                              RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill No" Binding="{Binding SerialNumber}" Width="110"/>
                            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="1.4*"/>
                            <DataGridTextColumn Header="MR / ID" Binding="{Binding MrNumber}" Width="100"/>
                            <DataGridTextColumn Header="Doctor" Binding="{Binding ReferredBy}" Width="1.2*"/>
                            <DataGridTextColumn Header="Tests" Binding="{Binding TestSummary}" Width="1.8*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAtDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="Net (PKR)" Binding="{Binding NetAmount, StringFormat=N0}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="txtSummary" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorTextSecondary}"/>
                <Button HorizontalAlignment="Right" Content="Close" Style="{StaticResource SecondaryButton}"
                        Height="42" Padding="18,0" Click="btnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
