<Window x:Class="LabReportApp.TestDefinitionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Predefined Tests" Height="800" Width="1120"
        MinHeight="560" MinWidth="860" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ColorBannerBg}" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Manage Predefined Tests" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Search the catalogue, then add or edit a test when you need to"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorHeaderSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource AccentButton}" Height="40" Click="btnAdd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Test" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Style="{StaticResource CardContent}" Padding="14,12">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch" Height="40"
                                 ToolTip="Search by test name, category, unit, or range"
                                 TextChanged="Filter_Changed"/>
                        <TextBlock IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{DynamicResource ColorTextSecondary}"
                                   Text="Search tests…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ComboBox x:Name="cmbCategory" Grid.Column="1" Height="40" Margin="8,0,0,0"
                                  SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="cmbKind" Grid.Column="2" Height="40" Margin="8,0,0,0"
                                  SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All types"/>
                            <ComboBoxItem Content="Individual tests"/>
                            <ComboBoxItem Content="Panels"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbStatus" Grid.Column="3" Height="40" Margin="8,0,0,0"
                                  SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All statuses"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                        <TextBlock x:Name="txtCount" Grid.Column="4" Margin="14,0,0,0"
                                   VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorTextSecondary}" Text="0 tests"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource CardBackground}"/>
                <Border Padding="8,4,8,8">
                    <DataGrid x:Name="dgDefinitions" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" SelectionMode="Single"
                              CanUserSortColumns="True" CanUserResizeColumns="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.PanningMode="None"
                              MouseDoubleClick="dgDefinitions_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryHeading}" Width="1.4*" MinWidth="120" SortMemberPath="CategoryHeading"/>
                            <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="2.2*" MinWidth="160" SortMemberPath="TestName"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" MinWidth="70" SortMemberPath="Unit"/>
                            <DataGridTextColumn Header="Legacy Range" Binding="{Binding NormalRange}" Width="1.4*" MinWidth="110" SortMemberPath="NormalRange"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="80" SortMemberPath="Price"/>
                            <DataGridCheckBoxColumn Header="Panel" Binding="{Binding IsPanel}" Width="64" SortMemberPath="IsPanel"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="64" SortMemberPath="IsActive"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <TextBlock x:Name="txtEmpty" Text="No tests match this search."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" IsHitTestVisible="False"
                           Visibility="Collapsed" Foreground="{DynamicResource ColorTextSecondary}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Double-click a row to edit it. Reference ranges stay on the individual test, not on a panel."
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,280,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Edit Selected" Style="{StaticResource SecondaryButton}" Height="40"
                            Click="btnEdit_Click"/>
                    <Button Content="Reference Ranges" Style="{StaticResource SecondaryButton}" Height="40"
                            Margin="8,0,0,0" Click="btnManageRanges_Click"/>
                    <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Height="40"
                            Margin="8,0,0,0" Click="btnDeleteDefinition_Click"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Height="40"
                            Margin="8,0,0,0" Click="btnCloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="pnlEditor" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="2"
              MouseLeftButtonDown="Backdrop_MouseDown">
            <Border Background="#B30F172A"/>
            <Border Width="680" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="EditorCard_MouseDown">
                <Grid>
                    <Border Style="{StaticResource CardBackground}"/>
                    <Border Style="{StaticResource CardContent}">
                        <StackPanel>
                            <TextBlock x:Name="txtEditorTitle" Text="Add Test" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="CATEGORY (MAIN HEADING) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtCategory" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="TEST NAME *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtTestName" Height="42"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,8,0">
                                    <TextBlock Text="UNIT" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtUnit" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,10,0,0">
                                    <TextBlock Text="LEGACY NORMAL RANGE (FALLBACK)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNormalRange" Height="42"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,8,0">
                                    <TextBlock Text="PRICE (PKR) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtPrice" Height="42"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,10,0,0" VerticalAlignment="Bottom">
                                    <CheckBox x:Name="chkIsPanel" Content="This is a panel (CBC, LFT, RFT)"
                                              Margin="0,8,0,8" Foreground="{DynamicResource ColorTextPrimary}" FontSize="14"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="40"
                                        Click="btnCancelEditor_Click" IsCancel="True"/>
                                <Button Content="Save Test" Style="{StaticResource AccentButton}" Height="40"
                                        Margin="8,0,0,0" Click="btnSaveDefinition_Click" IsDefault="True"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
